# Database
DATABASE_URL="postgresql://[username]:[password]@[host]:[port]/[database]?pgbouncer=true&timezone=Asia/Hong_Kong"
# Per-process pool ceiling. API, worker, scheduler, and content-worker share a
# 15-session Supavisor login in production.
DATABASE_POOL_MAX=3
# Migration-only direct PostgreSQL or Supavisor session-mode connection (5432).
# Do not use the transaction pooler (6543 or pgbouncer=true).
DATABASE_BACKUP_DIR=/var/backups/letletme-data
DATABASE_BACKUP_KEEP=7
DATABASE_BACKUP_PG_MAJOR=15

# Rebuildable Data publications only
CACHE_REDIS_HOST=redis.internal.example
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=your_cache_redis_password
CACHE_REDIS_DB=0

# BullMQ and worker coordination; must resolve to a different endpoint/database
QUEUE_REDIS_HOST=redis.internal.example
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=your_queue_redis_password
QUEUE_REDIS_DB=1

PORT=3000
# Local development keeps mutation auth off. Production requires ENABLE_AUTH=true
# and at least one SHA-256 digest in DATA_API_KEY_HASHES.
ENABLE_AUTH=false
# Comma-separated SHA-256 digests of internal service API keys.
# Generate a key with `openssl rand -base64 32`, then hash it with:
# `printf %s "$KEY" | shasum -a 256`
DATA_API_KEY_HASHES=
# Briefing content roles. Keep these separate from the general Data API key.
CONTENT_EDITOR_API_KEY_HASHES=
CONTENT_PUBLISHER_API_KEY_HASHES=
# All four Briefing flags are false by default; enable them in the staged order.
CONTENT_PIPELINE_ENABLED=false
CONTENT_ACQUISITION_SHADOW_MODE=false
CONTENT_X_SCAN_ENABLED=false
CONTENT_HTTP_ACQUISITION_ENABLED=false
CONTENT_PODCAST_TRANSCRIPT_ENABLED=false
CONTENT_YOUTUBE_DISCOVERY_ENABLED=false
CONTENT_YOUTUBE_NATIVE_ENABLED=false
CONTENT_YOUTUBE_GENERATED_ENABLED=false
CONTENT_REAL_GROK_ENABLED=false
CONTENT_PUBLICATION_ENABLED=false
BRIEFING_PUBLIC_ENABLED=false
# Grok Build, HTTP and transcript acquisition limits. No paid X API is used.
CONTENT_GROK_CONCURRENCY=2
CONTENT_HTTP_CONCURRENCY=4
CONTENT_HTTP_HOST_CONCURRENCY=2
CONTENT_HERMES_TRANSCRIPT_CONCURRENCY=1
CONTENT_HERMES_TRANSCRIPT_TIMEOUT_MS=7200000
CONTENT_HERMES_TRANSCRIPT_MAX_OUTPUT_BYTES=16777216
HERMES_TRANSCRIPT_URL=
HERMES_TRANSCRIPT_TOKEN=
CONTENT_SUPADATA_TIMEOUT_MS=75000
CONTENT_SUPADATA_MAX_OUTPUT_BYTES=16777216
CONTENT_SUPADATA_JOB_POLL_INTERVAL_MS=5000
CONTENT_GROK_TIMEOUT_MS=240000
CONTENT_GROK_MAX_OUTPUT_BYTES=4194304
CONTENT_GROK_EXPECTED_VERSION=1.0.5
CONTENT_GROK_RUNNER_SOCKET=/run/letletme-grok-runner/runner.sock
CONTENT_GROK_RUNNER_RELEASE_SHA=unknown
CONTENT_HTTP_TIMEOUT_MS=40000
CONTENT_HTTP_MAX_OUTPUT_BYTES=8388608
CONTENT_X_DAILY_CALL_LIMIT=2400
CONTENT_X_FINAL90_CALL_LIMIT=300
# Rolling 24h cap for x_user_search identity resolution. Keep this separate
# from recurring X scan budgets so initial manifest reconciliation cannot
# consume the entire provider allowance.
CONTENT_X_IDENTITY_CALL_LIMIT=100
CONTENT_SUPADATA_DAILY_CREDIT_LIMIT=0
CONTENT_HERMES_DAILY_AUDIO_MINUTES=0
SUPADATA_API_KEY=
YOUTUBE_DATA_API_KEY=
BRIEFING_REVALIDATE_URL=http://localhost:3000/api/briefing/revalidate
BRIEFING_REVALIDATE_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Private bug-report screenshots. Keep disabled until migration and bucket are ready.
BUG_REPORT_SCREENSHOT_STORAGE_ENABLED=false
BUG_REPORT_SCREENSHOT_SUPABASE_URL=
BUG_REPORT_SCREENSHOT_SUPABASE_SECRET_KEY=
BUG_REPORT_SCREENSHOT_BUCKET=bug-report-screenshots
BUG_REPORT_SCREENSHOT_RETENTION_DAYS=90
# HTTP mutation rate limit per client IP (fixed 1-minute window; 0 disables)
RATE_LIMIT_MUTATIONS_PER_MINUTE=60
# Private bug-report screenshots (service-role access only; enable after migration/bucket deploy).
BUG_REPORT_SCREENSHOT_STORAGE_ENABLED=false
BUG_REPORT_SCREENSHOT_SUPABASE_URL=
BUG_REPORT_SCREENSHOT_SUPABASE_SECRET_KEY=
BUG_REPORT_SCREENSHOT_BUCKET=bug-report-screenshots
BUG_REPORT_SCREENSHOT_RETENTION_DAYS=90
# Structured non-live attempt reports; set false only for emergency log rollback.
DATA_SYNC_ATTEMPT_REPORTING_ENABLED=true
# Keep the new-tournament official roster default off until lifecycle E2E and
# setup benchmarks pass. Eligible owners can still opt in explicitly.
TOURNAMENT_OFFICIAL_SYNC_DEFAULT_ENABLED=false
# Optional tuning:
# FPL_ADMISSION_LEASE_MS=45000
# FPL_MAX_INFLIGHT=5
# FPL_REQUESTS_PER_SECOND=4
# FPL_BULK_MAX_INFLIGHT_DURING_LIVE=3
# FPL_REQUEST_TIMEOUT_MS=10000
# FPL_REQUEST_DEADLINE_MS=40000
# FPL_RETRY_BASE_DELAY_MS=500
# FPL_RETRY_MAX_DELAY_MS=5000
# ENTRY_SYNC_CHUNK_SIZE=500
# ENTRY_SYNC_CONCURRENCY=5
# ENTRY_SYNC_THROTTLE_MS=200

# Understat provider (disabled by default; synchronization is manually/API queued)
UNDERSTAT_ENABLED=false
UNDERSTAT_BASE_URL=https://understat.com
UNDERSTAT_LEAGUE=EPL
UNDERSTAT_MIN_SEASON=2526
UNDERSTAT_SEASON=2627
UNDERSTAT_TIMEOUT_MS=10000
UNDERSTAT_MAX_CONCURRENCY=4

# Telegram direct bot API notifications (optional, used by src/utils/notify.ts sendTelegramMessage)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional WeChat notification bridge. Leave unset locally. In production both
# must be set together; the token is sent as a Bearer header.
# WECHAT_NOTIFICATION_URL=https://bot.example.com/wechatBot/letletme/notification
# WECHAT_NOTIFICATION_API_TOKEN=

# Bug-report screenshot cleanup (required in production; keep the HMAC secret
# identical in Web and Data).
# BUG_REPORT_STORAGE_INTERNAL_URL=https://web.example.com/api/internal/bug-report-storage
# BUG_REPORT_CLEANUP_SECRET=
# BUG_REPORT_STORAGE_LEGACY_ORIGIN=https://example.supabase.co
