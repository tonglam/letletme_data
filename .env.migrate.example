# Copy to .env.migrate on the deployment host. This file is loaded only by
# the one-shot migration container and must never be mounted into API/workers.
# Use the direct Supabase `postgres` connection, not a runtime LOGIN or pooler.
DATABASE_URL="postgresql://postgres:replace@db.example.supabase.co:5432/postgres?sslmode=require"

# Runtime LOGIN passwords provisioned after migrations. Keep these secrets only
# in .env.migrate; API and worker containers must never receive them.
DATA_RUNTIME_DB_PASSWORD=replace_with_64_character_data_runtime_secret
GRAPHQL_RUNTIME_DB_PASSWORD=replace_with_64_character_graphql_runtime_secret

# The runtime URLs must use the passwords above and the corresponding role
# names. Keep these values migration-only; API/worker containers use their own
# .env.deploy / GraphQL deployment environment.
DATA_RUNTIME_DATABASE_URL="postgresql://letletme_data_runtime:replace_with_64_character_data_runtime_secret@db.example.supabase.co:5432/postgres?sslmode=require"
GRAPHQL_RUNTIME_DATABASE_URL="postgresql://letletme_graphql_runtime:replace_with_64_character_graphql_runtime_secret@db.example.supabase.co:5432/postgres?sslmode=require"
