{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mode",
    "runId",
    "sourceSnapshotRevision",
    "windowStart",
    "windowEnd",
    "sources",
    "maxXCalls"
  ],
  "properties": {
    "profile": { "const": "week" },
    "mode": { "enum": ["poll", "enrich", "compose"] },
    "runId": { "type": "string", "format": "uuid" },
    "sourceSnapshotRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "windowStart": { "type": "string", "format": "date-time" },
    "windowEnd": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "platform",
          "externalId",
          "displayName",
          "sourceType",
          "reportingFamily",
          "rightsPolicy"
        ],
        "properties": {
          "sourceId": { "type": "string", "format": "uuid" },
          "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
          "externalId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "handle": { "type": ["string", "null"], "maxLength": 128 },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sourceType": { "type": "string", "minLength": 1, "maxLength": 64 },
          "reportingFamily": { "type": "string", "minLength": 1, "maxLength": 64 },
          "rightsPolicy": { "type": "object" }
        }
      }
    },
    "maxXCalls": { "type": "integer", "minimum": 1, "maximum": 20 }
  }
}
