{
  "name": "letletme_data",
  "version": "1.0.0",
  "description": "Letletme_data fetches data from the Fantasy Premier League servers, cleans and transforms the data, and then stores it in PostgreSQL and Redis, providing APIs for querying data.",
  "main": "index.js",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "NODE_ENV=production bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "worker": "bun src/worker.ts",
    "worker:dev": "bun --watch src/worker.ts",
    "worker:start": "NODE_ENV=production bun dist/worker.js",
    "content-worker": "bun src/content-worker.ts",
    "build": "bun build src/index.ts src/worker.ts src/content-worker.ts --target bun --outdir ./dist",
    "env:check": "bun validate-env.ts",
    "test": "bun test tests/unit",
    "test:integration": "RUN_INTEGRATION=1 bun test tests/integration",
    "test:publication:integration": "LOG_LEVEL=error RUN_INTEGRATION=1 bun test tests/integration/data-publication.test.ts tests/integration/redis-separation.test.ts",
    "test:core-publication-benchmark": "LOG_LEVEL=error RUN_INTEGRATION=1 RUN_B0_ACCEPTANCE=1 bun test tests/integration/core-publication-benchmark.test.ts",
    "test:all": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "coverage": "bun test --coverage",
    "bug-reports:storage-migrate": "bun scripts/migrate-bug-report-storage.ts",
    "lint": "bunx eslint . --ext .ts,.tsx --cache --config eslint.config.mjs",
    "lint:fix": "bunx eslint . --ext .ts,.tsx --cache --fix --config eslint.config.mjs",
    "format:check": "bunx prettier --check .",
    "format:fix": "bunx prettier --write .",
    "db:export": "bunx drizzle-kit export",
    "db:migrate": "bun scripts/apply-sql-migrations.ts",
    "db:studio": "bunx drizzle-kit studio",
    "db:migration-contract": "bun scripts/migration-login-contract.ts",
    "db:verify-runtime-logins": "bun scripts/verify-runtime-logins.ts",
    "db:bootstrap-runtime-login": "bun scripts/bootstrap-runtime-login.ts",
    "db:migrate:status": "bun scripts/apply-sql-migrations.ts --status",
    "cache:publish-core": "bun scripts/publish-core-cache.ts",
    "ops:assert-queue-quiescence": "bun scripts/assert-queue-quiescence.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonglam/letletme_data.git"
  },
  "keywords": [
    "FPL",
    "Letletme",
    "Elysia",
    "Bun",
    "PostgreSQL",
    "Redis",
    "TypeScript"
  ],
  "author": "Tong Lam",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "bun-types": "1.3.14",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/cron": "1.4.2",
    "bullmq": "^5.65.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.29",
    "file-type": "21.3.3",
    "ioredis": "^5.6.1",
    "pino": "^9.6.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.3"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.3.4",
    "ajv": "6.14.0",
    "brace-expansion": "5.0.9",
    "esbuild": "0.25.12",
    "file-type": "21.3.3",
    "flatted": "3.4.2",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "picomatch": "4.0.4",
    "uuid": "11.1.1"
  }
}
