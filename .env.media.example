# Copy to .env.media on the VPS. Docker Compose exposes this file only to the
# dedicated media-worker; do not put these Storage credentials in .env.deploy.
CONTENT_MEDIA_WORKER_ENABLED=false
CONTENT_MEDIA_SUPABASE_URL=https://example.supabase.co
CONTENT_MEDIA_SUPABASE_SECRET_KEY=replace_with_server_only_storage_key
CONTENT_MEDIA_BUCKET=briefing-source-media
CONTENT_MEDIA_CONCURRENCY=2
CONTENT_MEDIA_RETENTION_ENABLED=false
