# Copy to .env.deploy and set production secrets
# Dedicated non-admin Data LOGIN inheriting only letletme_data_writer.
# Keep the Supabase postgres migration URL in .env.migrate, never here.
DATABASE_URL="postgresql://letletme_data_runtime:pass@host:5432/db"

# Supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_KEY=replace

# Bug-report screenshot cleanup/migration. The Web service exposes only these
# HMAC-signed internal endpoints; keep the secret identical in both services.
BUG_REPORT_STORAGE_INTERNAL_URL=https://your-frontend.example.com/api/internal/bug-report-storage
BUG_REPORT_CLEANUP_SECRET=replace_with_shared_hmac_secret
# Required for the one-time legacy migration; set to this project's exact
# Supabase origin so foreign storage URLs fail closed.
BUG_REPORT_STORAGE_LEGACY_ORIGIN=https://example.supabase.co

# Rebuildable Data publications only (required explicitly in production)
CACHE_REDIS_HOST=redis.internal.example
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=replace_cache_secret
CACHE_REDIS_DB=0

# BullMQ and worker coordination (required and must resolve to a different tuple)
QUEUE_REDIS_HOST=redis.internal.example
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=replace_queue_secret
QUEUE_REDIS_DB=1

# API
PORT=3000
ENABLE_AUTH=true
DATA_API_KEY_HASHES=replace_with_sha256_hex_digest
CONTENT_EDITOR_API_KEY_HASHES=replace_with_sha256_hex_digest
CONTENT_PUBLISHER_API_KEY_HASHES=replace_with_sha256_hex_digest
CONTENT_PIPELINE_ENABLED=false
CONTENT_REAL_GROK_ENABLED=false
CONTENT_PUBLICATION_ENABLED=false
BRIEFING_PUBLIC_ENABLED=false
GROK_BIN=
CONTENT_SOURCE_GROUP_KEY=fpl-week
CONTENT_PARTITION_KEY=week
CONTENT_GROK_CONCURRENCY=1
CONTENT_POLL_MAX_X_CALLS=2
CONTENT_DAILY_X_CALL_BUDGET=24
BRIEFING_REVALIDATE_URL=https://your-frontend.example.com/api/briefing/revalidate
BRIEFING_REVALIDATE_SECRET=replace_with_shared_hmac_secret
CORS_ORIGINS=https://your-frontend.example.com
# Private bug-report screenshots; set true only after migration and bucket checks.
BUG_REPORT_SCREENSHOT_STORAGE_ENABLED=false
BUG_REPORT_SCREENSHOT_SUPABASE_URL=https://example.supabase.co
BUG_REPORT_SCREENSHOT_SUPABASE_SECRET_KEY=replace_with_server_only_storage_key
BUG_REPORT_SCREENSHOT_BUCKET=bug-report-screenshots
BUG_REPORT_SCREENSHOT_RETENTION_DAYS=90
