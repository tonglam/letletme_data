# Local Cloud Agent development defaults for letletme_data.
# Copied to .env by .cursor/start.sh when no .env is present.
# These are local-only, non-secret values for a self-contained dev database.

# PostgreSQL: direct session connection (no transaction pooler / pgbouncer).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/letletme_data"
DATABASE_POOL_MAX=3

# Rebuildable Data publications (cache) — Redis DB 0.
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0

# BullMQ and worker coordination — distinct Redis DB 1.
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1

PORT=3000
NODE_ENV=development

# Local development keeps mutation auth off.
ENABLE_AUTH=false
DATA_API_KEY_HASHES=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
